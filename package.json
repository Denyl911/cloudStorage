{
  "name": "cloud-storage",
  "version": "1.1.0",
  "description": "API REST de almacenamiento en la nube corporativo: carpetas jerárquicas, archivos compartidos, clientes, proyectos y formularios con respuestas exportables. Bun + Elysia + Drizzle ORM.",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.2.0",
    "@elysiajs/static": "^1.2.0",
    "@elysiajs/swagger": "^1.2.0",
    "drizzle-orm": "^0.39.3",
    "drizzle-typebox": "^0.3.0",
    "elysia": "1.2.14",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "logestic": "^1.2.4",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "bun-types": "latest",
    "drizzle-kit": "^0.30.4"
  },
  "module": "src/index.js"
}
